{
  "name": "browser-pods",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Self-hosted multi-tenant browser sandbox exposed as an MCP server: one isolated Xvfb + Chromium + noVNC desktop per session, with video/trace archiving.",
  "license": "MIT",
  "author": "linzhicong",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nicken/dsh-browser-use.git",
    "directory": "mcp"
  },
  "homepage": "https://github.com/nicken/dsh-browser-use/tree/main/mcp#readme",
  "bugs": {
    "url": "https://github.com/nicken/dsh-browser-use/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "browser-automation",
    "playwright",
    "sandbox",
    "novnc",
    "chromium",
    "agent"
  ],
  "engines": {
    "node": ">=22"
  },
  "files": [
    "src/",
    "scripts/",
    "docs/",
    "Dockerfile",
    "docker-compose.yml",
    "README.md",
    "README.en.md"
  ],
  "scripts": {
    "start": "node src/server.mjs",
    "smoke": "node scripts/smoke.mjs",
    "test": "node --test tests/config.test.mjs tests/auth.test.mjs tests/cert-ignore.test.mjs",
    "test:unit": "node --test tests/config.test.mjs tests/auth.test.mjs",
    "test:cert": "node --test tests/cert-ignore.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "playwright": "1.62.1",
    "zod": "^4.6.7"
  }
}
