{
  "name": "dsh-browser-use",
  "version": "0.2.0",
  "private": false,
  "type": "module",
  "description": "Per-session real-browser control over CDP with numbered observations, query reads and a deterministic safety layer.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "CREDITS.md",
    "docs/",
    "SECURITY.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "license": "MIT",
  "author": "linzhicong",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nicken/dsh-browser-use.git"
  },
  "homepage": "https://github.com/nicken/dsh-browser-use#readme",
  "bugs": {
    "url": "https://github.com/nicken/dsh-browser-use/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "browser",
    "browser-automation",
    "cdp",
    "agent",
    "mcp"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test tests/tools.unit.test.mjs tests/browser.integration.test.mjs",
    "test:unit": "node --test tests/tools.unit.test.mjs",
    "test:integration": "node --test tests/browser.integration.test.mjs"
  }
}
